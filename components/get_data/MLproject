name: get_data
conda_env: conda.yml
entry_points:
  main:
    parameters:
      sample:
        type: string
        description: sample
      artifact_name:
        type: string
        description: artifact name
      artifact_type:
        type: string
        description: artifact type
      artifact_description:
        type: string
        description: artifact description
    command: python run.py {sample} {artifact_name} {artifact_type} {artifact_description}
