name: train_val_test_split
conda_env: conda.yml
entry_points:
  main:
    parameters:
      input:
        type: string
        description: input
      test_size:
        type: float
        description: test size
      random_seed:
        type: int
        description: random seed
      stratify_by:
        type: string
        description: stratify by
    command: python run.py {input} {test_size} --random_seed {random_seed} --stratify_by
      {stratify_by}
