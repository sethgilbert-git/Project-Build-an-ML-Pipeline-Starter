name: test_regression_model
conda_env: conda.yml
entry_points:
  main:
    parameters:
      mlflow_model:
        type: string
        description: mlflow model
      test_dataset:
        type: string
        description: test dataset
      relative_tolerance:
        type: float
        description: relative tolerance
    command: python run.py --mlflow_model {mlflow_model} --test_dataset {test_dataset}
      --relative_tolerance {relative_tolerance}
