name: train_random_forest
conda_env: conda.yml
entry_points:
  main:
    parameters:
      trainval_artifact:
        type: string
        description: trainval artifact
      val_size:
        type: float
        description: val size
      random_seed:
        type: int
        description: random seed
      stratify_by:
        type: string
        description: stratify by
      rf_config:
        type: string
        description: rf config
      max_tfidf_features:
        type: int
        description: max tfidf features
      output_artifact:
        type: string
        description: output artifact
    command: python run.py --trainval_artifact {trainval_artifact} --val_size {val_size}
      --random_seed {random_seed} --stratify_by {stratify_by} --rf_config {rf_config}
      --max_tfidf_features {max_tfidf_features} --output_artifact {output_artifact}
